{
  "rules": {
    "poll": {
      ".read": true,
      "$classId": {
        ".read": true,
        ".write": "auth != null && auth.uid === '0KzuBx7a9yToozCzB9mm2UIFsRu2'",
        "options": {
          "$id": {
            "votes": {
              ".write": "!data.exists() && newData.val() === 1 || data.exists() && newData.val() === data.val() + 1"
            }
          }
        },
        "totalVotes": {
          ".write": "!data.exists() && newData.val() === 1 || data.exists() && newData.val() === data.val() + 1"
        },
        "voters": {
          "$fingerprint": {
            ".write": "!data.exists() && newData.exists()"
          }
        }
      }
    }
  }
}
